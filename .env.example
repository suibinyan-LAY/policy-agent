# 复制本文件为 .env，然后填入自己的密钥
DASHSCOPE_API_KEY=sk-在这里填你的Key

# 模型平台（OpenAI 兼容地址）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型
LLM_MODEL=deepseek-v4.1-flash
# 可选：覆盖下拉框的模型列表（逗号分隔）。留空则用内置预设：
# deepseek-v4.1-flash, qwen-turbo, qwen-plus, qwen-max, qwen-long, deepseek-v3, deepseek-r1
LLM_MODELS=

# 向量化模型
EMBED_MODEL=text-embedding-v3
